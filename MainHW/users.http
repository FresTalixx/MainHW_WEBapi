@baseUrl = http://localhost:5142
@email = test221.user@example.com
@password = Password123!
@token = 7d6dfb14-70d2-4aa5-8316-a64507ecce21

### Register a new user
POST {{baseUrl}}/api/user/register
Content-Type: application/json

{
  "name": "Test",
  "email": "{{email}}",
  "password": "{{password}}"
}

### Login with the new user
# Copy the token from the response and set @token below.
POST {{baseUrl}}/api/user/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

### Login with an incorrect password
POST {{baseUrl}}/api/user/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "WrongPassword123!"
}

### Register with invalid data
POST {{baseUrl}}/api/user/register
Content-Type: application/json

{
  "name": "No",
  "email": "not-an-email",
  "password": "123"
}

### Get all users
GET {{baseUrl}}/api/user/all
X-My-Authorization: {{token}}
Accept: application/json
